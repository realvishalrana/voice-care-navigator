# Google Cloud service account JSON path (STT + TTS) — optional
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
GCP_PROJECT_ID=your-gcp-project-id

# Groq API key (FREE — recommended for STT + answers)
# Get at: https://console.groq.com/keys
GROQ_API_KEY=ask_your_groq_api_key

# Gemini API key — optional if Groq is set
# Get at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Server
PORT=3001
NODE_ENV=development

# CORS is open (all origins). CORS_ORIGIN is unused.
